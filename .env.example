# ==============================================================================
# StudioSonar Configuration & Environment Variables
# ==============================================================================

# Google Cloud & Gemini Configuration
GCP_PROJECT_ID=studiosonar-dev
GCP_LOCATION=us-central1
BIGQUERY_DATASET=studiosonar_analytics
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Execution Mode: "live" (calls real APIs) or "mock" (simulates real responses for demo/testing)
EXECUTION_MODE=live

# External Integration Endpoints
SLACK_WEBHOOK_URL=https://example.com/slack/webhook-placeholder
NOTION_API_KEY=your_notion_api_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Safety & Anomaly Guardrails
MIN_ANOMALY_VELOCITY_PCT=250.0
CRITICAL_SENTIMENT_THRESHOLD=-0.60
CONFIDENCE_THRESHOLD=0.85

# Server & Port
PORT=8080
HOST=0.0.0.0
